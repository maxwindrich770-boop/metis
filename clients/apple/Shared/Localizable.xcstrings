{
  "sourceLanguage" : "en",
  "strings" : {
    "Waiting for Apple push registration…" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Apple-Push-Registrierung wird abgewartet …"}}}},
    "This build does not declare a valid Apple push registration environment." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Build enthält keine gültige Umgebung für die Apple-Push-Registrierung."}}}},
    "Your session is no longer valid. Sign in again." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Sitzung ist nicht mehr gültig. Melde dich erneut an."}}}},
    "The server returned an unknown push capability response. Check that the app and server are up to date, then try again." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Server hat eine unbekannte Antwort zur Push-Unterstützung geliefert. Prüfe, ob App und Server aktuell sind, und versuche es erneut."}}}},
    "This iPhone test build has no Apple push entitlement. Push alerts require a build signed with a push-enabled provisioning profile. iPhone Settings cannot enable push for this build." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese iPhone-Testversion unterstützt keine Push-Mitteilungen. Dafür wird eine App-Version benötigt, deren Apple-Signierung Push erlaubt. In den iPhone-Einstellungen lässt sich Push für diese Version nicht freischalten."}}}},
    "This Metis server does not yet provide the mobile push API. A server update is required before this app can enable push alerts." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Metis-Server stellt die mobile Push-Schnittstelle noch nicht bereit. Damit die App Push-Mitteilungen einschalten kann, muss der Server aktualisiert werden."}}}},
    "Checking push availability…" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Push-Unterstützung wird geprüft …"}}}},
    "Updating push registration…" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Push-Anmeldung wird aktualisiert …"}}}},
    "Notifications are turned off for Metis in iPhone Settings. Allow notifications there, then return to enable push alerts." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mitteilungen für Metis sind in den iPhone-Einstellungen ausgeschaltet. Erlaube sie dort und kehre anschließend hierher zurück, um Push einzuschalten."}}}},
    "Push support could not be checked. Check your connection and try again." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Push-Unterstützung konnte nicht geprüft werden. Prüfe deine Verbindung und versuche es erneut."}}}},
    "Apple push delivery is not configured on this Metis server. The server operator must configure it before you can enable push alerts." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Versand über Apple Push ist auf diesem Metis-Server nicht eingerichtet. Der Serverbetreiber muss ihn einrichten, bevor du Push-Mitteilungen einschalten kannst."}}}},
    "This server does not provide account details to the app. Your account settings are available in the Metis workspace." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Server stellt der App keine Kontodetails bereit. Deine Kontoeinstellungen findest du im Metis-Arbeitsbereich."}}}},
    "This Metis server does not yet support push device management." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Metis-Server unterstützt die Verwaltung von Push-Geräten noch nicht."}}}},
    "Requires a push-enabled build" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Push-fähige App-Version erforderlich"}}}},
