    "This build could not register for Apple push notifications." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese App-Version konnte sich nicht bei Apple Push anmelden. Prüfe deine Verbindung und versuche es erneut. Falls die Anmeldung weiter fehlschlägt, muss die Apple-Push-Signierung der App geprüft werden."}}}},
    "Push alerts disabled for this account." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Push-Mitteilungen für dieses Konto sind ausgeschaltet."}}}},
