    "The Metis workspace closed unexpectedly. Reload to continue." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Metis-Arbeitsbereich wurde unerwartet geschlossen. Lade ihn erneut, um fortzufahren."}}}},
