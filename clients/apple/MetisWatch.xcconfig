SDKROOT = watchos
SUPPORTED_PLATFORMS = watchos watchsimulator
// SwiftUI tasks and confirmation dialogs set the minimum supported OS.
WATCHOS_DEPLOYMENT_TARGET = 8.0
TARGETED_DEVICE_FAMILY = 4
SWIFT_VERSION = 5.0
ALWAYS_SEARCH_USER_PATHS = NO
PRODUCT_NAME = MetisWatch
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
METIS_PHONE_BUNDLE_ID = dev.metis.apple.prototype
PRODUCT_BUNDLE_IDENTIFIER = $(METIS_PHONE_BUNDLE_ID).watchkitapp
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = MetisWatch/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Metis
SKIP_INSTALL = YES
