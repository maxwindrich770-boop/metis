SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 5.0
ALWAYS_SEARCH_USER_PATHS = NO
PRODUCT_NAME = Metis
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
METIS_PHONE_BUNDLE_ID = dev.metis.apple.prototype
PRODUCT_BUNDLE_IDENTIFIER = $(METIS_PHONE_BUNDLE_ID)
// Keep the user-facing version in sync when CURRENT_PROJECT_VERSION advances.
MARKETING_VERSION = 0.1.$(CURRENT_PROJECT_VERSION)
CURRENT_PROJECT_VERSION = 23
METIS_RELEASE_CHANNEL = Developer Beta
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = MetisiOS/Info.plist
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Connect to your self-hosted Metis server on your local network.
INFOPLIST_KEY_NSFaceIDUsageDescription = Unlock Metis and confirm actions you choose to approve.
INFOPLIST_KEY_NSCameraUsageDescription = Take a photo to attach to a Metis message.
INFOPLIST_KEY_NSMicrophoneUsageDescription = Record audio for Metis voice input when you choose the microphone.
METIS_APNS_ENVIRONMENT = production
METIS_APNS_ENTITLEMENT = production
METIS_PUSH_UNAVAILABLE_REASON =
CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] = MetisiOS/Metis.entitlements
