SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 5.0
ALWAYS_SEARCH_USER_PATHS = NO
APPLICATION_EXTENSION_API_ONLY = YES
PRODUCT_NAME = MetisShare
METIS_PHONE_BUNDLE_ID = dev.metis.apple.prototype
PRODUCT_BUNDLE_IDENTIFIER = $(METIS_PHONE_BUNDLE_ID).share
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = MetisShare/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Metis
CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] = MetisShare/MetisShare.entitlements
SKIP_INSTALL = YES
